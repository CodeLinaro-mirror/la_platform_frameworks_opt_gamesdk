package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_test_host {
    name: "swappy_host_test",
    srcs: [
        "test/swappy_host/swappy_host_test.cpp",
        "games-frame-pacing/common/Settings.cpp",
    ],
    include_dirs: [
        "frameworks/opt/gamesdk/games-frame-pacing/common",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-std=c++17",
    ],
    static_libs: [
        "libgtest",
        "libgtest_main",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}
