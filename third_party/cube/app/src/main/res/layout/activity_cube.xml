<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/info_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="110dp"
        android:padding="24dp"
        android:orientation="vertical"
        android:visibility="invisible">
        <TextView
            android:id="@+id/target_fps_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/target_fps_ms"
            android:textAppearance="@style/InfoTextMedium" />

        <com.samples.cube.FrameTimeGraphView
            android:id="@+id/frame_time_graph"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/swappy_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/swappy_stats"
            android:textAppearance="@style/InfoTextMedium" />

        <GridLayout
            android:id="@+id/swappy_stats_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="7">
        </GridLayout>
    </LinearLayout>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/settingsLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="120dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:id="@+id/textViewVersionInfo"
            android:layout_margin="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/textViewGpuWork"
            android:layout_margin="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <SeekBar
            android:id="@+id/seekBarGpuWork"
            android:max="8000"
            android:progress="0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/textViewCpuWork"
            android:layout_margin="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <SeekBar
            android:id="@+id/seekBarCpuWork"
            android:max="8000"
            android:progress="0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Switch
            android:id="@+id/switchSwappy"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/use_swappy"
            android:textColor="#FFF"/>
        <Switch
            android:id="@+id/switchGoogleTiming"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/use_google_timing"
            android:textColor="#FFF"/>
        <Switch
            android:id="@+id/switch30FpsLimit"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fixed_30_fps_limit"
            android:textColor="#FFF"/>
    </LinearLayout>
</RelativeLayout>
