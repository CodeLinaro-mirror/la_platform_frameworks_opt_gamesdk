<?xml version="1.0" encoding="utf-8"?>
<!-- Copyright 2026 The Android Open Source Project -->
<configuration description="Config for AGDK Swappy test cases">
    <option name="test-suite-tag" value="gamesdk_tests" />
    <target_preparer class="com.android.tradefed.targetprep.suite.SuiteApkInstaller">
        <option name="cleanup-apks" value="true" />
        <option name="test-file-name" value="swappy-debug.apk" />
        <option name="test-file-name" value="swappy-debug-androidTest.apk" />
    </target_preparer>
    <test class="com.android.tradefed.testtype.AndroidJUnitTest">
        <option name="package" value="com.swappy.testapp.test" />
        <option name="runner" value="androidx.test.runner.AndroidJUnitRunner" />
    </test>
</configuration>
